---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    // newest-first ordering: newer = the post above this one, older = below
    props: { entry, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={entry.data.title} description={entry.data.excerpt}>
  <article>
    <div class="piece-head">
      <span class="piece-cat">Blog</span>
      <h1 class="piece-title">{entry.data.title}</h1>
      <p class="piece-date">{fmt(entry.data.date)}</p>
    </div>

    {entry.data.image && (
      <img class="piece-image" src={entry.data.image} alt={entry.data.title} />
    )}

    <div class="prose dropcap">
      <Content />
    </div>

    <div class="end-mark" aria-hidden="true"></div>

    {(newer || older) && (
      <nav class="piece-nav">
        {older && (
          <a href={`/blog/${older.id}/`}>
            <span class="dir">&larr; Earlier</span>
            {older.data.title}
          </a>
        )}
        {newer && (
          <a class="next" href={`/blog/${newer.id}/`}>
            <span class="dir">Later &rarr;</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )}

    <a class="back" href="/blog/">All posts</a>
  </article>

  <Comments slug={entry.id} title={entry.data.title} open={entry.data.comments} />
</Base>
