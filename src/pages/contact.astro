---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" description="Get in touch with David Proud — correspondence, readings, and tutoring enquiries.">
  <div class="piece-head">
    <span class="piece-cat">Correspondence</span>
    <h1 class="piece-title">Contact</h1>
  </div>

  <div class="contact-card">
    <p class="lead">
      Questions, readings, tutoring enquiries, and conversation
      are always welcome.
    </p>

    <ul class="contact-lines">
      <!-- PLACEHOLDER: swap for David's real email + LinkedIn once provided. -->
      <li>
        <span class="contact-label">Email</span>
        <span class="contact-value"><em>(David's email — to be added)</em></span>
      </li>
      <li>
        <span class="contact-label">LinkedIn</span>
        <span class="contact-value"><em>(David's LinkedIn — to be added)</em></span>
      </li>
    </ul>
  </div>

  <div class="end-mark" aria-hidden="true"></div>
</Base>
