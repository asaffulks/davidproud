---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import TestimonialForm from '../components/TestimonialForm.astro';

const testimonials = (await getCollection('testimonials', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  testimonials.map(async (t) => ({ t, Quote: (await render(t)).Content }))
);
---
<Base title="Testimonials" description="What students and readers say about working with David Proud.">
  <div class="piece-head">
    <span class="piece-cat">In their words</span>
    <h1 class="piece-title">Testimonials</h1>
  </div>

  <ul class="testimonials">
    {rendered.map(({ t, Quote }) => (
      <li class="testimonial">
        <blockquote class="testimonial-quote"><Quote /></blockquote>
        <p class="testimonial-attrib">
          {t.data.name}
          {t.data.role && <span class="role"> &middot; {t.data.role}</span>}
        </p>
      </li>
    ))}
  </ul>

  {testimonials.length === 0 && (
    <p class="section-label">Testimonials will appear here soon.</p>
  )}

  <TestimonialForm />

  <div class="home-more">
    <a class="btn btn--paper" href="/tutoring/">About Tutoring</a>
  </div>

  <div class="end-mark" aria-hidden="true"></div>
</Base>
