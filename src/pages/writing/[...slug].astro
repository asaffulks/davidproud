---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const writings = (await getCollection('writings', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return writings.map((entry, i) => ({
    params: { slug: entry.id },
    // newest-first ordering: prev = newer piece, next = older piece
    props: { entry, newer: writings[i - 1] ?? null, older: writings[i + 1] ?? null },
  }));
}

const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);

const isVerse = entry.data.category === 'Poetry';

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={entry.data.title} description={entry.data.excerpt}>
  <article>
    <div class="piece-head">
      <span class="piece-cat">{entry.data.topic ?? entry.data.category}</span>
      <h1 class="piece-title">{entry.data.title}</h1>
      <p class="piece-date">{fmt(entry.data.date)}</p>
    </div>

    {entry.data.image && (
      <img class="piece-image" src={entry.data.image} alt={entry.data.title} />
    )}

    <div class:list={['prose', isVerse ? 'verse' : 'dropcap']}>
      <Content />
    </div>

    <div class="end-mark" aria-hidden="true"></div>

    {(newer || older) && (
      <nav class="piece-nav">
        {older && (
          <a href={`/writing/${older.id}/`}>
            <span class="dir">&larr; Earlier</span>
            {older.data.title}
          </a>
        )}
        {newer && (
          <a class="next" href={`/writing/${newer.id}/`}>
            <span class="dir">Later &rarr;</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )}

    <a class="back" href="/writings/">All writings</a>
  </article>
</Base>
